# Sunshare account used by the bridge. Use a dedicated *invited user* account (invite a second
# account to your device from the iShareCloud app): that is enough for the bridge and your
# phone app stays logged in. Reusing your main account works too, but Sunshare allows one
# active session per account, so the bridge and the app would kick each other out.
SUNSHARE_USER_ACCOUNT=bridge@example.com
SUNSHARE_PASSWORD=changeme
# TRUE  = invited/guest account (default): NIGHT_MIN_SOC is enforced by the bridge only.
# FALSE = main account: NIGHT_MIN_SOC is also written to the device as its discharge stop
#         ("socMin", the app allows at most 20 %), and the feed-in cap (countryMaxPower) can
#         be changed. Device writes still need the controller enabled and out of dry-run.
SUNSHARE_USER_GUEST=TRUE

# From `python3 scripts/sunshare_login.py devices`:
# the numeric "id" and the device serial number "sn".
SUNSHARE_DEVICE_ID=12345
SUNSHARE_DEVICE_SN=YOUR_DEVICE_SERIAL

# Login for the web UI (single user). Set both to switch it on; without them the UI is open,
# which is only acceptable in a trusted LAN. REQUIRED as soon as the UI is reachable from
# outside (e.g. via a Cloudflare Tunnel - point it at the UI port only, never at LAN_PORT).
# Use a long password; changing it logs all sessions out.
#UI_USER=admin
#UI_PASSWORD=
# Optional: signing key of the session cookie (default: generated once into data/session_secret).
#UI_SESSION_SECRET=

# Your existing MQTT broker (e.g. the one your Home Assistant already uses).
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=sunshare

# Data source for the live values: "lan" (default; device push via NAT redirect)
# or "cloud" (polls the AES cloud endpoint). Read-only in the web UI.
DATA_SOURCE=lan

# Ports exposed by the container (see docker-compose.yml).
UI_PORT=8099
LAN_PORT=80

# Log verbosity: DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=INFO

# How often to keep the real-time session open / poll the cloud (seconds).
KEEPALIVE_INTERVAL=3
CLOUD_POLL_INTERVAL=2
# Cumulative PV-yield stats (kWh) - not gated by the real-time session, so a
# much slower poll is fine.
ENERGY_POLL_INTERVAL=60

# Power-flow history: one averaged value per minute in data/history.db, kept this many days.
HISTORY_RETENTION_DAYS=30

# "Raw" page: how many of the device's telemetry pushes are kept in memory (not persisted).
RAW_LOG_SIZE=500

# Zero-feed-in controller (off + dry-run until enabled in the web UI). It needs a grid meter
# that is published to your MQTT broker (positive = import from the grid, ~1 value/minute is
# enough). Without one the controller stays idle - the rest of the bridge works fine.
# Either point METER_CONFIG_TOPIC at the meter's Home Assistant discovery topic (the state topic
# is read from it) or set METER_STATE_TOPIC directly; METER_VALUE_PATH is a dotted JSON path
# into the payload (e.g. ENERGY.Power), empty for a plain number.
#METER_CONFIG_TOPIC=homeassistant/sensor/<your_meter>/power/config
#METER_STATE_TOPIC=
#METER_VALUE_PATH=
CONTROL_TARGET_W=20        # aim for this much grid import (buffer against export)
CONTROL_DEADBAND_W=25
CONTROL_GAIN=0.7           # fraction of the error corrected per step
CONTROL_MIN_W=0
CONTROL_MAX_W=800          # never command more than this (<= the inverter's country limit)
CONTROL_MIN_INTERVAL=60    # seconds between writes; kept >= your meter's own reporting delay (UI: 60-120s)
CONTROL_METER_MAX_AGE=180  # no meter sample for this long -> failsafe output
CONTROL_FALLBACK_W=0

# Battery plan (UI checkbox "Batterie-Plan"). The values below are only the DEFAULTS:
# they are editable in the web UI ("System-Konfiguration"), persisted in data/control.json
# and win over this file on the next start ("Standard (.env)" in the UI restores these).
# Day: keep CHARGE_RESERVE_W for
# charging until SOC >= CHARGE_FULL_SOC, feed only PV above that; once full, output
# = PV pass-through. Night: follow the meter up to NIGHT_MAX_W while SOC > NIGHT_MIN_SOC.
BATTERY_CAPACITY_WH=1526
CHARGE_RESERVE_W=200
CHARGE_FULL_SOC=95
CHARGE_RELEASE_SOC=90
NIGHT_START=23:00
NIGHT_END=06:00
NIGHT_MAX_W=150
NIGHT_MIN_SOC=25
